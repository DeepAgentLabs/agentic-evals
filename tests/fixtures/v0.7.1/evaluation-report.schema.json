{
  "$defs": {
    "CaseEvaluation": {
      "description": "One case's result.\n\n`sample_available` is `False` when no sample was supplied for the case;\nits empty `trace_id` then means \"no trace exists\", not \"trace ID lost\".",
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "case_name": {
          "title": "Case Name",
          "type": "string"
        },
        "cost_source": {
          "anyOf": [
            {
              "enum": [
                "measured",
                "estimated"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Source"
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "latency_ms": {
          "title": "Latency Ms",
          "type": "number"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "output": {
          "title": "Output",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "sample_available": {
          "default": true,
          "title": "Sample Available",
          "type": "boolean"
        },
        "scores": {
          "items": {
            "$ref": "#/$defs/Score"
          },
          "title": "Scores",
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "case_name",
        "passed",
        "scores",
        "output",
        "trace_id",
        "latency_ms"
      ],
      "title": "CaseEvaluation",
      "type": "object"
    },
    "EvaluationSummary": {
      "properties": {
        "average_latency_ms": {
          "title": "Average Latency Ms",
          "type": "number"
        },
        "average_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Average Score",
          "type": "number"
        },
        "cost_sources": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Cost Sources",
          "type": "object"
        },
        "failed_cases": {
          "title": "Failed Cases",
          "type": "integer"
        },
        "metrics": {
          "additionalProperties": {
            "$ref": "#/$defs/MetricSummary"
          },
          "title": "Metrics",
          "type": "object"
        },
        "pass_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Pass Rate",
          "type": "number"
        },
        "passed_cases": {
          "title": "Passed Cases",
          "type": "integer"
        },
        "priced_cases": {
          "default": 0,
          "minimum": 0,
          "title": "Priced Cases",
          "type": "integer"
        },
        "tags": {
          "additionalProperties": {
            "$ref": "#/$defs/TagSummary"
          },
          "title": "Tags",
          "type": "object"
        },
        "total_cases": {
          "title": "Total Cases",
          "type": "integer"
        },
        "total_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Cost Usd"
        }
      },
      "required": [
        "total_cases",
        "passed_cases",
        "failed_cases",
        "pass_rate",
        "average_score",
        "average_latency_ms"
      ],
      "title": "EvaluationSummary",
      "type": "object"
    },
    "MetricSummary": {
      "description": "How one metric did across the suite. Skipped scores are counted apart.",
      "properties": {
        "average_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Score"
        },
        "failed": {
          "title": "Failed",
          "type": "integer"
        },
        "pass_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pass Rate"
        },
        "passed": {
          "title": "Passed",
          "type": "integer"
        },
        "skipped": {
          "default": 0,
          "title": "Skipped",
          "type": "integer"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "total",
        "passed",
        "failed"
      ],
      "title": "MetricSummary",
      "type": "object"
    },
    "Score": {
      "description": "A single named judgment.\n\n`metric` is the stable key reports group by. It defaults to `name`;\nchecks whose name carries a per-case detail (`contains:42`,\n`required_tool:lookup`) share one metric (`contains`, `required_tool`).\n\nA `skipped` score records that a check did not apply to a case. It\nnever fails the case and is left out of averages and pass rates --\nbuild one with `Score.skip(...)`.\n\n`evaluator` and `evaluator_version` identify what produced the score.\n`evaluate_suite` stamps them: built-in checks are attributed to\n`BUILTIN_EVALUATOR` at this package's version, and registered\nevaluators to their registry name and their `version` attribute, if\nany. A `None` version means the evaluator did not declare one.",
      "properties": {
        "evaluator": {
          "default": "",
          "title": "Evaluator",
          "type": "string"
        },
        "evaluator_type": {
          "default": "deterministic",
          "title": "Evaluator Type",
          "type": "string"
        },
        "evaluator_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluator Version"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "metric": {
          "default": "",
          "title": "Metric",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "skipped": {
          "default": false,
          "title": "Skipped",
          "type": "boolean"
        },
        "value": {
          "maximum": 1,
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "value",
        "passed",
        "explanation"
      ],
      "title": "Score",
      "type": "object"
    },
    "TagSummary": {
      "description": "How the cases carrying one tag did.",
      "properties": {
        "average_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Score"
        },
        "failed_cases": {
          "title": "Failed Cases",
          "type": "integer"
        },
        "pass_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Pass Rate",
          "type": "number"
        },
        "passed_cases": {
          "title": "Passed Cases",
          "type": "integer"
        },
        "total_cases": {
          "title": "Total Cases",
          "type": "integer"
        }
      },
      "required": [
        "total_cases",
        "passed_cases",
        "failed_cases",
        "pass_rate"
      ],
      "title": "TagSummary",
      "type": "object"
    }
  },
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/CaseEvaluation"
      },
      "title": "Cases",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "suite_name": {
      "title": "Suite Name",
      "type": "string"
    },
    "suite_version": {
      "title": "Suite Version",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/EvaluationSummary"
    }
  },
  "required": [
    "suite_name",
    "suite_version",
    "summary",
    "cases"
  ],
  "title": "EvaluationReport",
  "type": "object"
}
